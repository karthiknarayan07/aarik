<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Video</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.apple.quicktime-movie</string>
				<string>public.mpeg-4</string>
				<string>com.apple.m4v-video</string>
				<string>public.image</string>
			</array>
		</dict>
	</array>
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Shrink Media</string>
			</dict>
			<key>NSMessage</key>
			<string>shrinkVideos</string>
			<key>NSPortName</key>
			<string>$(PRODUCT_NAME)</string>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.movie</string>
				<string>public.image</string>
			</array>
			<key>NSRequiredContext</key>
			<dict/>
		</dict>
	</array>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>$(PRODUCT_NAME) reads your Photos library to find large videos. It only changes Photos when you choose to convert a video.</string>
	<key>AppHelpURL</key>
	<string>$(APP_HELP_URL)</string>
	<key>SUFeedURL</key>
	<string>$(APP_UPDATE_FEED_URL)</string>
	<key>SUPublicEDKey</key>
	<string>$(APP_UPDATE_PUBLIC_KEY)</string>
	<key>SUEnableAutomaticChecks</key>
	<true/>
	<key>SUEnableInstallerLauncherService</key>
	<false/>
</dict>
</plist>
