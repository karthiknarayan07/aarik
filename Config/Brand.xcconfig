// The only place the product's brand lives. To rename the app, edit these values (plus assets and docs).
// Every other build setting and all code refer to these variables, never to the literal name.

APP_DISPLAY_NAME = Aarik
APP_PRODUCT_NAME = Aarik
APP_BUNDLE_ID_PREFIX = io.github.karthiknarayan07

// GitHub home of the project: Releases host the DMGs, GitHub Pages hosts the update feed.
APP_GITHUB_OWNER = karthiknarayan07
APP_GITHUB_REPO = aarik
